{
  "name": "hermes-agent-cn-desktop",
  "version": "0.8.0-rc9",
  "private": true,
  "author": "Hermes Agent CN Contributors",
  "homepage": "https://hermesagent.org.cn",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "node scripts/only-pnpm.mjs",
    "version:sync": "node scripts/sync-desktop-version.mjs",
    "version:check": "node scripts/sync-desktop-version.mjs --check",
    "license:sync": "node scripts/generate-license-rtf.mjs",
    "license:check": "node scripts/generate-license-rtf.mjs --check",
    "grid:check": "node scripts/check-4px-grid.mjs",
    "dev": "pnpm web:dev",
    "web:dev": "pnpm run version:sync && pnpm --filter @hermes/web dev",
    "web:build": "pnpm run version:sync && pnpm --filter @hermes/web build",
    "web:build:desktop": "pnpm run version:sync && pnpm --filter @hermes/web build:desktop",
    "tauri:dev": "pnpm run version:sync && node scripts/tauri-dev-external.mjs",
    "tauri:build": "pnpm run license:sync && pnpm run version:sync && pnpm exec tauri build --bundles nsis",
    "tauri:build:debug": "pnpm run license:sync && pnpm run version:sync && pnpm exec tauri build --debug",
    "tauri:run": "pnpm run version:sync && cargo run",
    "typecheck": "pnpm run license:check && pnpm run version:check && pnpm run grid:check && pnpm -r run typecheck",
    "test:unit": "pnpm -r --workspace-concurrency=1 test:unit",
    "test:e2e": "pnpm --filter @hermes/e2e test",
    "test:e2e:smoke": "pnpm --filter @hermes/e2e smoke",
    "tauri:dev:external": "pnpm run version:sync && node scripts/tauri-dev-external.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0"
  }
}
